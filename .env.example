# Copy to .env. No public domain is required for the initial localhost check.
GEORISK_PORT=8000

# Runtime caps for the server and all its calculation subprocesses.
GEORISK_CPUS=0.5
GEORISK_MEMORY_LIMIT=2g
# GDAL cache in MiB per process, included in the total memory limit.
GEORISK_GDAL_CACHE_MB=64

# Later: set the exact domain/IP names, without schemes or ports.
# Keep 127.0.0.1 for the container's health check.
GEORISK_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Later: the public origin, for example https://hazards.example.org.
# Leave empty for localhost. A URL path does not belong in the origin.
GEORISK_PUBLIC_ORIGIN=
# Empty for a domain root; /georisk for a reverse proxy that strips that prefix.
GEORISK_BASE_PATH=
# Set to 1 when enabling the public HTTPS site.
GEORISK_COOKIE_SECURE=0
# Set the real proxy peer IP(s) before public deployment. Never use *.
# A proxy on the Linux host normally appears as the Docker bridge gateway,
# not as 127.0.0.1 inside the container. See README_LINUX_DOCKER.md.
GEORISK_TRUSTED_PROXIES=127.0.0.1
