# Linux host HTTPS proxy: set the real domain/certificates later. Choose ONE example.
# 'zone' directives belong inside the main http {} context, outside server {}.
limit_req_zone $binary_remote_addr zone=georisk_requests:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=georisk_uploads:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=georisk_sessions:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=georisk_connections:10m;
map $request_method $georisk_job_key {
    default "";
    POST $binary_remote_addr;
}
limit_req_zone $georisk_job_key zone=georisk_job_submissions:10m rate=3r/m;

server {
    listen 80;
    server_name example.org;
    return 308 https://example.org$request_uri;
}

server {
    listen 443 ssl;
    server_name example.org;
    ssl_certificate /etc/letsencrypt/live/example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    absolute_redirect off;
    client_max_body_size 201m;
    client_header_timeout 10s;
    client_body_timeout 30s;
    send_timeout 30s;
    keepalive_timeout 15s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_conn georisk_connections 20;
    limit_req zone=georisk_requests burst=30 nodelay;

    # Forwarded values are overwritten, never trusted from the browser.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_request_buffering off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    location = /api/session {
        limit_req zone=georisk_requests burst=30 nodelay;
        limit_req zone=georisk_sessions burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    location = /api/uploads {
        limit_req zone=georisk_requests burst=30 nodelay;
        limit_req zone=georisk_uploads burst=2 nodelay;
        limit_conn georisk_connections 2;
        proxy_pass http://127.0.0.1:8000;
    }
    location = /api/jobs {
        # Polling history uses GET. Only POST consumes this dedicated budget.
        # See the map above: an empty key is not accounted by limit_req.
        limit_req zone=georisk_requests burst=30 nodelay;
        limit_req zone=georisk_job_submissions burst=2 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
    }
}

